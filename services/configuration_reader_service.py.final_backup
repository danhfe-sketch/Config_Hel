    def _direct_update_apn_fields(self, apn_server, apn_user=None, apn_password=None):
        """
        Directly update APN fields in the UI.
        
        Args:
            apn_server: APN server value
            apn_user: APN user value (optional)
            apn_password: APN password value (optional)
        """
        try:
            self._log_message(f"DEBUG: Directly updating APN fields - server: {apn_server}, user: {apn_user}, password: {apn_password}")
            
            # Check if we have access to the parameters frame
            if not hasattr(self.app, 'parameters_frame'):
                self._log_message("ERROR: Cannot update APN fields - parameters_frame not found")
                return
            
            # Update APN server field
            if hasattr(self.app.parameters_frame, 'apn_server_entry'):
                def update_apn_server():
                    try:
                        self.app.parameters_frame.apn_server_entry.delete(0, 'end')
                        self.app.parameters_frame.apn_server_entry.insert(0, apn_server)
                        self._log_message(f"DEBUG: Updated APN server entry directly to {apn_server}")
                    except Exception as e:
                        self._log_message(f"ERROR: Failed to update APN server entry: {str(e)}")
                
                # Schedule the update on the main thread
                self.app.after(0, update_apn_server)
            
            # Update APN user field
            if apn_user and hasattr(self.app.parameters_frame, 'apn_user_entry'):
                def update_apn_user():
                    try:
                        self.app.parameters_frame.apn_user_entry.delete(0, 'end')
                        self.app.parameters_frame.apn_user_entry.insert(0, apn_user)
                        self._log_message(f"DEBUG: Updated APN user entry directly to {apn_user}")
                    except Exception as e:
                        self._log_message(f"ERROR: Failed to update APN user entry: {str(e)}")
                
                # Schedule the update on the main thread
                self.app.after(0, update_apn_user)
            
            # Update APN password field
            if apn_password and hasattr(self.app.parameters_frame, 'apn_password_entry'):
                def update_apn_password():
                    try:
                        self.app.parameters_frame.apn_password_entry.delete(0, 'end')
                        self.app.parameters_frame.apn_password_entry.insert(0, apn_password)
                        self._log_message(f"DEBUG: Updated APN password entry directly to {apn_password}")
                    except Exception as e:
                        self._log_message(f"ERROR: Failed to update APN password entry: {str(e)}")
                
                # Schedule the update on the main thread
                self.app.after(0, update_apn_password)
        except Exception as e:
            self._log_message(f"ERROR: Failed to update APN fields: {str(e)}")
    
    def _direct_update_server_fields(self, server_address, server_port=None):
        """
        Directly update server fields in the UI.
        
        Args:
            server_address: Server address value
            server_port: Server port value (optional)
        """
        try:
            self._log_message(f"DEBUG: Directly updating server fields - address: {server_address}, port: {server_port}")
            
            # Check if we have access to the parameters frame
            if not hasattr(self.app, 'parameters_frame'):
                self._log_message("ERROR: Cannot update server fields - parameters_frame not found")
                return
            
            # Update server address field
            if hasattr(self.app.parameters_frame, 'parameter_widgets') and 'server_ip' in self.app.parameters_frame.parameter_widgets:
                server_ip_widget = self.app.parameters_frame.parameter_widgets['server_ip']
                if hasattr(server_ip_widget, 'widget'):
                    def update_server_address():
                        try:
                            server_ip_widget.set_value(server_address)
                            self._log_message(f"DEBUG: Updated server address to {server_address}")
                        except Exception as e:
                            self._log_message(f"ERROR: Failed to update server address: {str(e)}")
                    
                    # Schedule the update on the main thread
                    self.app.after(0, update_server_address)
            
            # Update server port field
            if server_port and hasattr(self.app.parameters_frame, 'parameter_widgets') and 'server_port' in self.app.parameters_frame.parameter_widgets:
                server_port_widget = self.app.parameters_frame.parameter_widgets['server_port']
                if hasattr(server_port_widget, 'widget'):
                    def update_server_port():
                        try:
                            server_port_widget.set_value(server_port)
                            self._log_message(f"DEBUG: Updated server port to {server_port}")
                        except Exception as e:
                            self._log_message(f"ERROR: Failed to update server port: {str(e)}")
                    
                    # Schedule the update on the main thread
                    self.app.after(0, update_server_port)
        except Exception as e:
            self._log_message(f"ERROR: Failed to update server fields: {str(e)}")
    
    def _direct_update_protocol_field(self, protocol_value):
        """
        Directly update protocol field in the UI.
        
        Args:
            protocol_value: Protocol value
        """
        try:
            self._log_message(f"DEBUG: Directly updating protocol field to {protocol_value}")
            
            # Check if we have access to the parameters frame
            if not hasattr(self.app, 'parameters_frame'):
                self._log_message("ERROR: Cannot update protocol field - parameters_frame not found")
                return
            
            # Update protocol field
            if hasattr(self.app.parameters_frame, 'parameter_widgets') and 'gt06_protocol' in self.app.parameters_frame.parameter_widgets:
                protocol_widget = self.app.parameters_frame.parameter_widgets['gt06_protocol']
                if hasattr(protocol_widget, 'widget'):
                    def update_protocol():
                        try:
                            protocol_widget.set_value(protocol_value)
                            self._log_message(f"DEBUG: Updated protocol to {protocol_value}")
                        except Exception as e:
                            self._log_message(f"ERROR: Failed to update protocol: {str(e)}")
                    
                    # Schedule the update on the main thread
                    self.app.after(0, update_protocol)
                else:
                    self._log_message("WARNING: Protocol widget does not have a widget attribute")
            else:
                self._log_message("WARNING: Protocol widget not found in parameter_widgets")
                
                # List available widgets for debugging
                if hasattr(self.app.parameters_frame, 'parameter_widgets'):
                    available_widgets = list(self.app.parameters_frame.parameter_widgets.keys())
                    self._log_message(f"DEBUG: Available parameter widgets: {available_widgets}")
        except Exception as e:
            self._log_message(f"ERROR: Failed to update protocol field: {str(e)}")
    
    def _debug_dump_parameters_frame(self):
        """Dump the parameters frame structure for debugging."""
        try:
            self._log_message("DEBUG: Dumping parameters frame structure")
            
            # Check if we have access to the parameters frame
            if not hasattr(self.app, 'parameters_frame'):
                self._log_message("ERROR: Cannot dump parameters frame - not found")
                return
            
            # Dump parameter widgets
            if hasattr(self.app.parameters_frame, 'parameter_widgets'):
                self._log_message(f"DEBUG: Parameter widgets: {list(self.app.parameters_frame.parameter_widgets.keys())}")
                
                # Dump each widget
                for name, widget in self.app.parameters_frame.parameter_widgets.items():
                    self._log_message(f"DEBUG: Widget {name}: {type(widget).__name__}")
                    
                    # Check if the widget has a get_value method
                    if hasattr(widget, 'get_value'):
                        try:
                            value = widget.get_value()
                            self._log_message(f"DEBUG: Widget {name} value: {value}")
                        except Exception as e:
                            self._log_message(f"ERROR: Failed to get value for widget {name}: {str(e)}")
            else:
                self._log_message("WARNING: Parameters frame does not have parameter_widgets attribute")
            
            # Dump APN entries
            if hasattr(self.app.parameters_frame, 'apn_server_entry'):
                self._log_message("DEBUG: APN server entry found")
            if hasattr(self.app.parameters_frame, 'apn_user_entry'):
                self._log_message("DEBUG: APN user entry found")
            if hasattr(self.app.parameters_frame, 'apn_password_entry'):
                self._log_message("DEBUG: APN password entry found")
            
            # Dump methods
            methods = [method for method in dir(self.app.parameters_frame) if callable(getattr(self.app.parameters_frame, method)) and not method.startswith('_')]
            self._log_message(f"DEBUG: Parameters frame methods: {methods}")
        except Exception as e:
            self._log_message(f"ERROR: Failed to dump parameters frame: {str(e)}")
        def reset_error_statistics(self) -> None:
            """Reset error statistics for a fresh start."""
        self.total_read_attempts = 0
        self.successful_reads = 0
        self.failed_reads = 0
        self.last_read_attempt = None
        self._log_message("INFO: Configuration reading error statistics reset")