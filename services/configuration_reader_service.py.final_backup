        except Exception as e:
            self._log_message(f"ERROR: Failed to update server fields: {str(e)}")
    
    def _update_protocol_field(self, value):
        """Update protocol field in the UI."""
        try:
            # Get the protocol widget
            protocol_widget = self.app.parameters_frame.get_parameter_widget('gt06_protocol')
            if protocol_widget:
                current_value = protocol_widget.get_value()
                
                # Update the widget
                def update_widget():
                    try:
                        protocol_widget.set_value(value)
                        value_changed = current_value != value
                        self.app.parameters_frame.highlight_updated_parameter('gt06_protocol', value_changed)
                        self._log_message(f"DEBUG: Updated protocol to {value}")
                    except Exception as e:
                        self._log_message(f"ERROR: Failed to update protocol: {str(e)}")
                
                # Schedule the update on the main thread
                self.app.after(0, update_widget)
            else:
                self._log_message("WARNING: Protocol widget not found")
        except Exception as e:
            self._log_message(f"ERROR: Failed to update protocol field: {str(e)}")
    
