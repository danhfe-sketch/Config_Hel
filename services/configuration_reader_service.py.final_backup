    def _direct_update_ui(self, parameters_read):
        """
        Directly update UI fields with values read from the device.
        This method bypasses all the mapping logic and directly updates the UI fields.
        
        Args:
            parameters_read: List of parameter read results
        """
        try:
            self._log_message("DEBUG: Starting direct UI update")
            
            # Check if we have access to the parameters frame
            if not hasattr(self.app, 'parameters_frame'):
                self._log_message("ERROR: Cannot update UI - parameters_frame not found")
                return
            
            # Extract values from parameter read results
            for result in parameters_read:
                if not result.success or result.value is None:
                    continue
                
                param_name = result.parameter_name
                value = result.value
                
                self._log_message(f"DEBUG: Processing parameter {param_name} with value {value}")
                
                # Handle specific parameters directly
                if param_name == 'apn_config':
                    self._update_apn_fields(value)
                elif param_name == 'server_config':
                    self._update_server_fields(value)
                elif param_name == 'protocol_settings':
                    self._update_protocol_field(value)
                elif param_name == 'timer_settings':
                    self._update_timer_fields(value)
                elif param_name == 'heartbeat_settings':
                    self._update_heartbeat_fields(value)
                elif param_name == 'defense_settings':
                    self._update_defense_field(value)
        except Exception as e:
            self._log_message(f"ERROR: Failed to update UI: {str(e)}")
            import traceback
            self._log_message(f"ERROR: Traceback: {traceback.format_exc()}")
    
    def _update_apn_fields(self, value):
        """Update APN fields in the UI."""
        try:
            # Get the APN server widget
            apn_server_widget = self.app.parameters_frame.get_parameter_widget('apn_server')
            if apn_server_widget:
                current_value = apn_server_widget.get_value()
                
                # Update the widget
                def update_widget():
                    try:
                        apn_server_widget.set_value(value)
                        value_changed = current_value != value
                        self.app.parameters_frame.highlight_updated_parameter('apn_server', value_changed)
                        self._log_message(f"DEBUG: Updated APN server to {value}")
                    except Exception as e:
                        self._log_message(f"ERROR: Failed to update APN server: {str(e)}")
                
                # Schedule the update on the main thread
                self.app.after(0, update_widget)
            else:
                self._log_message("WARNING: APN server widget not found")
            
            # Also try to update the APN fields directly
            if hasattr(self.app.parameters_frame, 'apn_server_entry'):
                self.app.after(0, lambda: self.app.parameters_frame.apn_server_entry.delete(0, 'end'))
                self.app.after(10, lambda: self.app.parameters_frame.apn_server_entry.insert(0, value))
                self._log_message(f"DEBUG: Updated APN server entry directly to {value}")
        except Exception as e:
            self._log_message(f"ERROR: Failed to update APN fields: {str(e)}")
    
    def _update_server_fields(self, value):
        """Update server fields in the UI."""
        try:
            # Get the server IP widget
            server_ip_widget = self.app.parameters_frame.get_parameter_widget('server_ip')
            if server_ip_widget:
                current_value = server_ip_widget.get_value()
                
                # Update the widget
